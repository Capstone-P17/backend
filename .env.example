# Copy this file to .env and fill in the values you need.

# FastAPI app
APP_NAME="AI Security Audit Backend"
APP_VERSION="1.0.0"
ENVIRONMENT="local"
API_PREFIX=""
HOST="0.0.0.0"
PORT=8000
RELOAD=false
# Docker/production images set this to false to hide /docs, /redoc, and /openapi.json.
DOCS_ENABLED=true

# Logging
# LOG_LEVEL: TRACE, DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
LOG_COLORIZE=true
LOG_JSON=false
LOG_BACKTRACE=false
LOG_DIAGNOSE=false
# Set true when you also want rotating file logs under WORKSPACE_ROOT/LOG_FILE_PATH.
LOG_FILE_ENABLED=false
LOG_FILE_PATH="logs/backend.log"
LOG_FILE_ROTATION="10 MB"
LOG_FILE_RETENTION="14 days"
LOG_FILE_COMPRESSION="gz"

# Workspace / analysis
WORKSPACE_ROOT="."
ANALYSIS_DEFAULT_TARGET="src/analyzer/test_samples"
ANALYSIS_MAX_FINDINGS_IN_PROMPT=20
MAX_UPLOAD_BYTES=104857600
MAX_ARCHIVE_MEMBERS=5000
# Guardrails for repository analysis. Java files beyond these limits are rejected before analysis.
MAX_ANALYSIS_JAVA_FILES=5000
MAX_ANALYSIS_FILE_BYTES=1048576

# Agent defaults
DEFAULT_AGENT_NAME="security-audit-agent"

# OpenAI
# Required for LLM-backed report generation.
OPENAI_API_KEY=""

# Auth / GitHub OAuth BFF flow
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub OAuth App callback URL.
# This must point to the backend because the backend exchanges the GitHub code.
# Example for local backend:
#   http://localhost:8000/auth/github/callback
GITHUB_REDIRECT_URI="http://localhost:8000/auth/github/callback"

# Frontend route to visit after the backend finishes GitHub login.
# The backend sets the JWT in an HttpOnly cookie and redirects here.
# Do not put JWT/access_token in this URL.
# Examples:
#   http://localhost:3000/auth/callback
#   http://localhost:5173/auth/callback
#   https://app.example.com/auth/callback
FRONTEND_AUTH_CALLBACK_URL="http://localhost:3000/auth/callback"

# JWT cookie used by the backend after OAuth callback.
# Frontend requests must include credentials, e.g. fetch(..., { credentials: "include" }).
AUTH_COOKIE_NAME="access_token"

# Use true in HTTPS environments. Local HTTP development may need false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE="lax"

# Short-lived OAuth CSRF protection cookie used during GitHub login.
OAUTH_STATE_COOKIE_NAME="github_oauth_state"

# Required. Generate at least 32 bytes, e.g.:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=""

# CORS (JSON array format)
# Must include the frontend origin when CORS_ALLOW_CREDENTIALS=true.
# Do not use ["*"] with credentialed cookie auth.
ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Database
# Used when running the app directly. Docker Compose builds DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=""

# Docker Compose Postgres credentials. Do not use these sample values in production.
POSTGRES_USER="backend-user"
POSTGRES_PASSWORD="change-this-postgres-password"
POSTGRES_DB="backend-db"
